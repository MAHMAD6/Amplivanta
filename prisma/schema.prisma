// ----------------------------------------------------------------------
// Super Admin platform governance
//
// Added for the approved Super Admin handoff. These models are additive and
// self-contained: cross-links to User / Organization are stored as plain ids
// (no FK) so the existing product schema is untouched. Relations are used only
// inside this cluster and for Plan -> FeatureEntitlement.
// ----------------------------------------------------------------------

enum AdminScopeLevel {
  GLOBAL
  ORGANIZATION
  WORKSPACE
  MODULE
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum SuspensionStatus {
  ACTIVE
  LIFTED
}

enum ModuleStatus {
  ENABLED
  DISABLED
}

enum GrantType {
  ACCESS_EXTENSION
  USAGE_CREDIT
  BILLING_CREDIT
  FEATURE_ACCESS
}

enum PartyStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

enum TicketStatus {
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

enum DataRequestType {
  ACCESS
  DELETION
  EXPORT
  RECTIFICATION
}

enum DataRequestStatus {
  RECEIVED
  IN_PROGRESS
  COMPLETED
  REJECTED
}

model RoleDefinition {
  id          String                @id @default(cuid())
  key         String                @unique
  name        String
  description String?
  isSystem    Boolean               @default(false)
  permissions RolePermissionGrant[]
  assignments AdminAssignment[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
}

model RolePermissionGrant {
  id               String         @id @default(cuid())
  roleDefinitionId String
  roleDefinition   RoleDefinition @relation(fields: [roleDefinitionId], references: [id], onDelete: Cascade)
  permissionKey    String
  allowed          Boolean        @default(true)

  @@unique([roleDefinitionId, permissionKey])
}

model AdminAssignment {
  id               String          @id @default(cuid())
  userId           String
  user             User            @relation("AdminAssignmentSubject", fields: [userId], references: [id], onDelete: Cascade)
  roleDefinitionId String?
  roleDefinition   RoleDefinition? @relation(fields: [roleDefinitionId], references: [id], onDelete: SetNull)
  scopeLevel       AdminScopeLevel @default(GLOBAL)
  organizationId   String?
  organization     Organization?   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspaceId      String?
  moduleKey        String?
  grantedByUserId  String?
  grantedBy        User?           @relation("AdminAssignmentGrantedBy", fields: [grantedByUserId], references: [id], onDelete: SetNull)
  expiresAt        DateTime?
  createdAt        DateTime        @default(now())

  @@index([userId])
  @@index([organizationId])
}

model Invitation {
  id               String           @id @default(cuid())
  email            String
  roleDefinitionId String?
  scopeLevel       AdminScopeLevel  @default(ORGANIZATION)
  organizationId   String?
  organization     Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  token            String           @unique
  status           InvitationStatus @default(PENDING)
  invitedByUserId  String?
  invitedBy        User?            @relation("InvitationInvitedBy", fields: [invitedByUserId], references: [id], onDelete: SetNull)
  expiresAt        DateTime
  acceptedAt       DateTime?
  createdAt        DateTime         @default(now())

  @@index([email])
}

model UserSession {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  device       String?
  browser      String?
  os           String?
  ipAddress    String?
  location     String?
  lastActiveAt DateTime  @default(now())
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId])
}

model AccessSuspension {
  id                String           @id @default(cuid())
  userId            String
  user              User             @relation("SuspensionSubject", fields: [userId], references: [id], onDelete: Cascade)
  reason            String
  status            SuspensionStatus @default(ACTIVE)
  suspendedByUserId String?
  suspendedBy       User?            @relation("SuspensionIssuedBy", fields: [suspendedByUserId], references: [id], onDelete: SetNull)
  liftedAt          DateTime?
  createdAt         DateTime         @default(now())

  @@index([userId])
}

model PlatformAuditLog {
  id           String           @id @default(cuid())
  actorUserId  String?
  actor        User?            @relation("PlatformAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  action       String
  resourceType String?
  resourceId   String?
  scopeLevel   AdminScopeLevel?
  reason       String?
  metadata     Json?
  ipAddress    String?
  createdAt    DateTime         @default(now())

  @@index([actorUserId])
  @@index([createdAt])
}

model ModuleControl {
  id              String          @id @default(cuid())
  key             String          @unique
  name            String
  description     String?
  category        String?
  status          ModuleStatus    @default(ENABLED)
  scopeLevel      AdminScopeLevel @default(GLOBAL)
  isCore          Boolean         @default(false)
  organizationId  String?
  updatedByUserId String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model FeatureFlag {
  id             String          @id @default(cuid())
  key            String          @unique
  name           String
  description    String?
  enabled        Boolean         @default(false)
  rolloutPercent Int?
  scopeLevel     AdminScopeLevel @default(GLOBAL)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model UsageCostRecord {
  id             String        @id @default(cuid())
  periodStart    DateTime
  periodEnd      DateTime
  category       String
  provider       String?
  units          Float         @default(0)
  cost           Float         @default(0)
  currency       String        @default("USD")
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())

  @@index([periodStart])
}

model SystemHealthCheck {
  id        String   @id @default(cuid())
  service   String
  status    String
  latencyMs Int?
  message   String?
  checkedAt DateTime @default(now())

  @@index([service, checkedAt])
}

model FeatureEntitlement {
  id         String   @id @default(cuid())
  planId     String
  plan       Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  featureKey String
  limitValue Int?
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@unique([planId, featureKey])
}

model CreditAdjustment {
  id              String        @id @default(cuid())
  grantType       GrantType
  amount          Float?
  days            Int?
  userId          String?
  user            User?         @relation("CreditRecipient", fields: [userId], references: [id], onDelete: SetNull)
  organizationId  String?
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  reason          String
  note            String?
  grantedByUserId String?
  grantedBy       User?         @relation("CreditGrantedBy", fields: [grantedByUserId], references: [id], onDelete: SetNull)
  effectiveAt     DateTime?
  expiresAt       DateTime?
  createdAt       DateTime      @default(now())

  @@index([organizationId])
}

model PricingBenchmark {
  id         String   @id @default(cuid())
  competitor String
  planName   String
  price      Float
  currency   String   @default("USD")
  interval   String   @default("month")
  sourceUrl  String?
  capturedAt DateTime @default(now())
}

model AffiliateProgramSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

model AffiliateApplication {
  id               String      @id @default(cuid())
  name             String
  email            String
  website          String?
  status           PartyStatus @default(PENDING)
  notes            String?
  reviewedByUserId String?
  reviewedAt       DateTime?
  createdAt        DateTime    @default(now())
}

model Affiliate {
  id             String       @id @default(cuid())
  userId         String?
  name           String
  email          String       @unique
  code           String       @unique
  status         PartyStatus  @default(PENDING)
  commissionRate Float        @default(0)
  referrals      Referral[]
  commissions    Commission[]
  payouts        Payout[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Referral {
  id             String        @id @default(cuid())
  affiliateId    String
  affiliate      Affiliate     @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  visitorId      String?
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  source         String?
  status         String        @default("pending")
  landedAt       DateTime      @default(now())
  convertedAt    DateTime?
  commissions    Commission[]

  @@index([affiliateId])
}

model Commission {
  id          String    @id @default(cuid())
  affiliateId String
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  referralId  String?
  referral    Referral? @relation(fields: [referralId], references: [id], onDelete: SetNull)
  amount      Float
  currency    String    @default("USD")
  status      String    @default("pending")
  periodStart DateTime?
  periodEnd   DateTime?
  createdAt   DateTime  @default(now())

  @@index([affiliateId])
}

model Payout {
  id          String       @id @default(cuid())
  affiliateId String
  affiliate   Affiliate    @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  amount      Float
  currency    String       @default("USD")
  status      PayoutStatus @default(PENDING)
  method      String?
  reference   String?
  processedAt DateTime?
  createdAt   DateTime     @default(now())

  @@index([affiliateId])
}

model FraudSignal {
  id          String    @id @default(cuid())
  affiliateId String?
  referralId  String?
  signal      String
  severity    String    @default("low")
  details     Json?
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
}

model PartnerProgram {
  id          String           @id @default(cuid())
  name        String
  slug        String           @unique
  description String?
  status      String           @default("draft")
  profiles    PartnerProfile[]
  createdAt   DateTime         @default(now())
}

model PartnerProfile {
  id           String          @id @default(cuid())
  programId    String?
  program      PartnerProgram? @relation(fields: [programId], references: [id], onDelete: SetNull)
  companyName  String
  contactEmail String
  website      String?
  tier         String?
  status       PartyStatus     @default(PENDING)
  createdAt    DateTime        @default(now())
}

model PartnerApplication {
  id           String      @id @default(cuid())
  programId    String?
  companyName  String
  contactEmail String
  status       PartyStatus @default(PENDING)
  notes        String?
  reviewedAt   DateTime?
  createdAt    DateTime    @default(now())
}

model SupportTicket {
  id               String          @id @default(cuid())
  subject          String
  requesterEmail   String
  organizationId   String?
  organization     Organization?   @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  priority         String          @default("normal")
  status           TicketStatus    @default(OPEN)
  assignedToUserId String?
  assignedTo       User?           @relation("TicketAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  messages         TicketMessage[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([status])
}

model TicketMessage {
  id          String        @id @default(cuid())
  ticketId    String
  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorEmail String?
  body        String        @db.Text
  isInternal  Boolean       @default(false)
  createdAt   DateTime      @default(now())
}

model Announcement {
  id          String    @id @default(cuid())
  title       String
  body        String    @db.Text
  audience    String    @default("all")
  publishedAt DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
}

model ProductUpdate {
  id          String    @id @default(cuid())
  title       String
  body        String    @db.Text
  version     String?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
}

model ConsentRecord {
  id           String   @id @default(cuid())
  subjectEmail String
  consentType  String
  granted      Boolean  @default(false)
  source       String?
  ipAddress    String?
  recordedAt   DateTime @default(now())

  @@index([subjectEmail])
}

model SuppressionEntry {
  id        String   @id @default(cuid())
  email     String
  reason    String
  source    String?
  createdAt DateTime @default(now())

  @@unique([email, reason])
}

model DataRequest {
  id           String            @id @default(cuid())
  subjectEmail String
  type         DataRequestType
  status       DataRequestStatus @default(RECEIVED)
  notes        String?
  requestedAt  DateTime          @default(now())
  completedAt  DateTime?
}

model PlatformIncident {
  id         String    @id @default(cuid())
  title      String
  severity   String    @default("low")
  status     String    @default("open")
  summary    String?
  detectedAt DateTime  @default(now())
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([status])
}

model PlatformNotification {
  id        String    @id @default(cuid())
  title     String
  body      String?
  level     String    @default("info")
  audience  String    @default("super_admin")
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([createdAt])
}

enum JobStatus {
  DRAFT
  OPEN
  CLOSED
}

enum ApplicationStage {
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  HIRED
  REJECTED
}

model JobOpening {
  id           String           @id @default(cuid())
  title        String
  slug         String           @unique
  department   String?
  location     String?
  employment   String?
  description  String?          @db.Text
  status       JobStatus        @default(DRAFT)
  publishedAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  applications JobApplication[]

  @@index([status])
}

model JobApplication {
  id           String           @id @default(cuid())
  jobOpeningId String
  jobOpening   JobOpening       @relation(fields: [jobOpeningId], references: [id], onDelete: Cascade)
  candidate    String
  email        String
  phone        String?
  resumeUrl    String?
  coverLetter  String?          @db.Text
  source       String?
  stage        ApplicationStage @default(APPLIED)
  notes        String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([jobOpeningId])
  @@index([stage])
}

// ----------------------------------------------------------------------
// Marketplace (downloadable marketing products)
//
// Distinct from Partner Program (business partnerships) and Affiliate Program
// (referral commissions) - see the approved integration handoff. Enums mirror
// the approved state machines exactly; order items snapshot the purchased
// product/license version so historical purchases stay addressable.
// ----------------------------------------------------------------------

enum SellerStatus {
  APPLICANT
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
  CLOSED
}

enum MarketplaceProductStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  CHANGES_REQUESTED
  APPROVED
  PUBLISHED
  UNPUBLISHED
  SUSPENDED
  ARCHIVED
  REJECTED
}

enum MarketplaceProductType {
  TEMPLATE
  IMAGE
  VIDEO
  GRAPHIC
  DOCUMENT
  TOOL_KIT
}

enum MarketplaceOrderStatus {
  INITIATED
  PAYMENT_PENDING
  PAID
  ACCESS_READY
  PAYMENT_FAILED
  REFUND_PENDING
  PARTIALLY_REFUNDED
  REFUNDED
  CHARGEBACK_OPEN
  CHARGEBACK_RESOLVED
}

enum EntitlementStatus {
  PENDING
  ACTIVE
  REVOKED
  EXPIRED
}

enum MarketplacePayoutStatus {
  ELIGIBLE
  REQUESTED
  PENDING
  PROCESSING
  PAID
  HELD
  FAILED
  CANCELLED
}

enum AssetScanStatus {
  PENDING
  CLEAN
  INFECTED
  FAILED
}

model MarketplaceSeller {
  id               String       @id @default(cuid())
  userId           String       @unique
  user             User         @relation("MarketplaceSellerUser", fields: [userId], references: [id], onDelete: Cascade)
  workspaceId      String?
  storeName        String
  slug             String       @unique
  headline         String?
  bio              String?      @db.Text
  status           SellerStatus @default(APPLICANT)
  // Payout provider account reference only - never raw bank or KYC details.
  payoutProvider   String?
  payoutAccountRef String?
  approvedAt       DateTime?
  suspendedAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  products     MarketplaceProduct[]
  ledger       MarketplaceLedgerEntry[]
  payouts      MarketplacePayout[]
  applications MarketplaceSellerApplication[]

  @@index([status])
}

model MarketplaceSellerApplication {
  id               String             @id @default(cuid())
  userId           String
  sellerId         String?
  seller           MarketplaceSeller? @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  storeName        String
  contactEmail     String
  website          String?
  productTypes     String[]
  motivation       String?            @db.Text
  status           SellerStatus       @default(APPLICANT)
  reviewNotes      String?
  reviewedByUserId String?
  reviewedAt       DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([status])
  @@index([userId])
}

model MarketplaceCategory {
  id          String                @id @default(cuid())
  slug        String                @unique
  name        String
  description String?
  parentId    String?
  parent      MarketplaceCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    MarketplaceCategory[] @relation("CategoryTree")
  order       Int                   @default(0)
  isActive    Boolean               @default(true)
  products    MarketplaceProduct[]
  createdAt   DateTime              @default(now())
}

/// How a Marketplace listing was made. Required on every product by the
/// Marketplace spec so buyers are told whether generative AI produced it.
enum ContentCreation {
  HUMAN_CREATED
  AI_ASSISTED
  PRIMARILY_AI_GENERATED
}

model MarketplaceProduct {
  id          String                   @id @default(cuid())
  sellerId    String
  seller      MarketplaceSeller        @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  categoryId  String?
  category    MarketplaceCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  slug        String                   @unique
  title       String
  summary     String?
  description String?                  @db.Text
  type        MarketplaceProductType
  status      MarketplaceProductStatus @default(DRAFT)
  tags        String[]
  coverImage  String?
  publishedAt DateTime?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  /// Listing gallery. coverImage stays the primary image; these are the rest,
  /// in display order. Alt text is stored positionally alongside them.
  galleryImages    String[]
  coverImageAlt    String?
  galleryImageAlts String[]

  /// Buyer-facing listing detail.
  language        String           @default("English")
  /// Nullable only so listings created before the disclosure existed stay valid;
  /// the server requires it on every new product.
  contentCreation ContentCreation?
  highlights      String[] /// "What's Included" bullets.
  perfectFor      String[] /// "Perfect For" audience bullets.

  /// Search and discoverability. Seller-authored; the marketplace never
  /// generates these on the seller's behalf.
  seoTitle        String?
  metaDescription String?
  primaryKeyword  String?
  keywords        String[]
  allowIndexing   Boolean  @default(true)

  versions   MarketplaceProductVersion[]
  orderItems MarketplaceOrderItem[]
  reviews    MarketplaceReview[]
  moderation MarketplaceModerationEvent[]
  favorites  MarketplaceFavorite[]

  @@index([status])
  @@index([sellerId])
}

/// New seller content creates a new version; existing orders keep referencing the old one.
model MarketplaceProductVersion {
  id             String                   @id @default(cuid())
  productId      String
  product        MarketplaceProduct       @relation(fields: [productId], references: [id], onDelete: Cascade)
  version        Int
  priceCents     Int                      @default(0)
  currency       String                   @default("USD")
  licenseVersion String                   @default("standard-v1")
  licenseHash    String?
  changelog      String?
  status         MarketplaceProductStatus @default(DRAFT)
  createdAt      DateTime                 @default(now())

  assets       MarketplaceProductAsset[]
  orderItems   MarketplaceOrderItem[]
  entitlements MarketplaceEntitlement[]

  @@unique([productId, version])
}

model MarketplaceProductAsset {
  id         String                    @id @default(cuid())
  versionId  String
  version    MarketplaceProductVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  kind       String                    @default("deliverable")
  storageKey String
  fileName   String
  mimeType   String?
  sizeBytes  Int?
  checksum   String?
  scanStatus AssetScanStatus           @default(PENDING)
  createdAt  DateTime                  @default(now())

  @@index([versionId])
}

model MarketplaceModerationEvent {
  id          String                   @id @default(cuid())
  productId   String
  product     MarketplaceProduct       @relation(fields: [productId], references: [id], onDelete: Cascade)
  fromStatus  MarketplaceProductStatus
  toStatus    MarketplaceProductStatus
  reason      String?
  actorUserId String?
  createdAt   DateTime                 @default(now())

  @@index([productId])
}

model MarketplaceCartItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  versionId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  /// Set when the item was added as part of a bundle.
  bundleId String?

  @@unique([userId, productId])
  @@index([userId])
}

model MarketplaceOrder {
  id               String                 @id @default(cuid())
  buyerUserId      String
  buyer            User                   @relation("MarketplaceOrderBuyer", fields: [buyerUserId], references: [id], onDelete: Cascade)
  status           MarketplaceOrderStatus @default(INITIATED)
  subtotalCents    Int                    @default(0)
  taxCents         Int                    @default(0)
  totalCents       Int                    @default(0)
  currency         String                 @default("USD")
  // Provider reference only - never raw payment credentials.
  paymentProvider  String?
  paymentIntentRef String?
  placedAt         DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  items    MarketplaceOrderItem[]
  refunds  MarketplaceRefund[]
  disputes MarketplaceDispute[]

  /// Coupon applied at checkout and the discount it produced (already
  /// reflected in totalCents and in each item's snapshot price).
  couponCode    String?
  discountCents Int     @default(0)
  /// Affiliate code captured from a ?ref= link, for commission attribution.
  affiliateRef  String?

  @@index([buyerUserId])
  @@index([status])
}

/// Immutable snapshot of exactly what was purchased.
model MarketplaceOrderItem {
  id               String                    @id @default(cuid())
  orderId          String
  order            MarketplaceOrder          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId        String
  product          MarketplaceProduct        @relation(fields: [productId], references: [id])
  productVersionId String
  productVersion   MarketplaceProductVersion @relation(fields: [productVersionId], references: [id])
  sellerId         String
  titleSnapshot    String
  licenseVersion   String
  licenseHash      String?
  unitPriceCents   Int
  quantity         Int                       @default(1)
  totalCents       Int
  currency         String                    @default("USD")
  createdAt        DateTime                  @default(now())

  entitlements MarketplaceEntitlement[]
  ledger       MarketplaceLedgerEntry[]

  @@index([orderId])
  @@index([sellerId])
}

model MarketplaceEntitlement {
  id               String                    @id @default(cuid())
  orderItemId      String
  orderItem        MarketplaceOrderItem      @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  buyerUserId      String
  buyer            User                      @relation("MarketplaceEntitlementBuyer", fields: [buyerUserId], references: [id], onDelete: Cascade)
  productVersionId String
  productVersion   MarketplaceProductVersion @relation(fields: [productVersionId], references: [id])
  status           EntitlementStatus         @default(PENDING)
  activatedAt      DateTime?
  revokedAt        DateTime?
  revokedReason    String?
  expiresAt        DateTime?
  createdAt        DateTime                  @default(now())

  downloads MarketplaceDownload[]

  @@index([buyerUserId])
  @@index([status])
}

/// One row per issued signed download URL - the audit trail for file access.
model MarketplaceDownload {
  id            String                 @id @default(cuid())
  entitlementId String
  entitlement   MarketplaceEntitlement @relation(fields: [entitlementId], references: [id], onDelete: Cascade)
  assetId       String?
  ipAddress     String?
  userAgent     String?
  issuedAt      DateTime               @default(now())
  expiresAt     DateTime?

  @@index([entitlementId])
}

model MarketplaceRefund {
  id                String           @id @default(cuid())
  orderId           String
  order             MarketplaceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amountCents       Int
  currency          String           @default("USD")
  reason            String
  status            String           @default("pending")
  requestedByUserId String?
  decidedByUserId   String?
  decidedAt         DateTime?
  createdAt         DateTime         @default(now())

  @@index([orderId])
}

model MarketplaceDispute {
  id          String           @id @default(cuid())
  orderId     String
  order       MarketplaceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind        String           @default("chargeback")
  status      String           @default("open")
  amountCents Int?
  providerRef String?
  openedAt    DateTime         @default(now())
  resolvedAt  DateTime?
  resolution  String?

  @@index([status])
}

/// Seller earnings ledger - payout eligibility is calculated from this, never a stored UI assumption.
model MarketplaceLedgerEntry {
  id          String                @id @default(cuid())
  sellerId    String
  seller      MarketplaceSeller     @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  orderItemId String?
  orderItem   MarketplaceOrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  entryType   String
  grossCents  Int                   @default(0)
  feeCents    Int                   @default(0)
  netCents    Int                   @default(0)
  currency    String                @default("USD")
  availableAt DateTime?
  payoutId    String?
  payout      MarketplacePayout?    @relation(fields: [payoutId], references: [id], onDelete: SetNull)
  createdAt   DateTime              @default(now())

  @@index([sellerId])
}

model MarketplacePayout {
  id          String                  @id @default(cuid())
  sellerId    String
  seller      MarketplaceSeller       @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  amountCents Int
  currency    String                  @default("USD")
  status      MarketplacePayoutStatus @default(REQUESTED)
  provider    String?
  providerRef String?
  requestedAt DateTime                @default(now())
  processedAt DateTime?
  failureNote String?

  ledger MarketplaceLedgerEntry[]

  @@index([sellerId])
  @@index([status])
}

/// Buyer wishlist. A favourite is a private bookmark, never an entitlement,
/// so it carries no pricing or licence state and is safe to delete freely.
model MarketplaceFavorite {
  id          String             @id @default(cuid())
  buyerUserId String
  buyer       User               @relation("MarketplaceFavoriteBuyer", fields: [buyerUserId], references: [id], onDelete: Cascade)
  productId   String
  product     MarketplaceProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt   DateTime           @default(now())

  @@unique([productId, buyerUserId])
  @@index([buyerUserId])
}

model MarketplaceReview {
  id          String             @id @default(cuid())
  productId   String
  product     MarketplaceProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  buyerUserId String
  orderItemId String?
  rating      Int
  title       String?
  body        String?            @db.Text
  isVerified  Boolean            @default(true)
  createdAt   DateTime           @default(now())

  @@unique([productId, buyerUserId])
  @@index([productId])
}

model MarketplaceSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Credits (External API Master Revision, section 4.2)
//
// Credits are an Amplivanta ledger, not a Stripe balance. Stripe only takes
// the money; the wallet, the append-only ledger and consumption live here.
// Plan and purchased credits are kept apart so plan credits can be consumed
// first. Workspace-owned, so these carry a plain workspaceId.
// ---------------------------------------------------------------------------

enum CreditBucket {
  PLAN
  PURCHASED
}

enum CreditLedgerKind {
  PLAN_ALLOCATION
  PURCHASE
  USAGE
  ADMIN_ADJUSTMENT
  REFUND
  EXPIRATION
}

model CreditWallet {
  id               String   @id @default(cuid())
  workspaceId      String   @unique
  planCredits      Int      @default(0)
  purchasedCredits Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model CreditLedgerEntry {
  id           String           @id @default(cuid())
  workspaceId  String
  kind         CreditLedgerKind
  bucket       CreditBucket
  /// Signed: positive grants, negative consumption.
  amount       Int
  balanceAfter Int
  /// What caused the entry, e.g. "stripe_checkout" + session id. Unique per
  /// kind and bucket so a replayed event can never post the same credit twice.
  sourceType   String
  sourceId     String
  note         String?
  actorUserId  String?
  createdAt    DateTime         @default(now())

  @@unique([sourceType, sourceId, kind, bucket])
  @@index([workspaceId, createdAt])
}

model CreditPurchase {
  id              String    @id @default(cuid())
  workspaceId     String
  userId          String?
  packCode        String
  /// Quantity and amount are fixed server-side at checkout creation.
  credits         Int
  amountCents     Int
  currency        String
  stripeSessionId String    @unique
  paymentRef      String?
  status          String    @default("pending")
  createdAt       DateTime  @default(now())
  fulfilledAt     DateTime?

  @@index([workspaceId])
}

/// Durable record of every provider webhook event, for replay protection.
model ProviderEvent {
  id          String    @id @default(cuid())
  provider    String
  eventId     String
  type        String
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  error       String?

  @@unique([provider, eventId])
}

/// A sign-in identity from an OAuth/OIDC provider, keyed by the provider's
/// immutable subject rather than by email.
model UserIdentity {
  id        String   @id @default(cuid())
  userId    String
  provider  String
  subject   String
  email     String?
  createdAt DateTime @default(now())

  @@unique([provider, subject])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Marketplace extensions (feature-flagged): store follows, coupons, bundles,
// sponsored placements.
// ---------------------------------------------------------------------------

model MarketplaceStoreFollow {
  id        String   @id @default(cuid())
  sellerId  String
  userId    String
  createdAt DateTime @default(now())

  @@unique([sellerId, userId])
  @@index([userId])
}

model MarketplaceCoupon {
  id              String    @id @default(cuid())
  /// Stored upper-case; matched case-insensitively.
  code            String    @unique
  /// Null for a platform-wide coupon; otherwise it discounts only that seller's items.
  sellerId        String?
  percentOff      Int?
  amountOffCents  Int?
  currency        String?
  startsAt        DateTime?
  endsAt          DateTime?
  maxRedemptions  Int?
  redemptions     Int       @default(0)
  isActive        Boolean   @default(true)
  createdByUserId String?
  createdAt       DateTime  @default(now())

  @@index([sellerId])
}

model MarketplaceBundle {
  id         String                  @id @default(cuid())
  sellerId   String
  slug       String                  @unique
  title      String
  summary    String?
  priceCents Int
  currency   String                  @default("USD")
  /// DRAFT | PUBLISHED | ARCHIVED
  status     String                  @default("DRAFT")
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt
  items      MarketplaceBundleItem[]

  @@index([sellerId])
}

model MarketplaceBundleItem {
  id        String            @id @default(cuid())
  bundleId  String
  bundle    MarketplaceBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  productId String

  @@unique([bundleId, productId])
}

/// Admin-curated paid/curated placement. Always rendered with its label.
model MarketplaceSponsoredPlacement {
  id              String    @id @default(cuid())
  productId       String
  placement       String    @default("home")
  label           String    @default("Sponsored")
  startsAt        DateTime  @default(now())
  endsAt          DateTime?
  isActive        Boolean   @default(true)
  createdByUserId String?
  createdAt       DateTime  @default(now())

  @@index([placement, isActive])
}

/// Anonymous public-site event counts (no personal data, no workspace).
model SiteEventAggregate {
  id    String   @id @default(cuid())
  name  String
  path  String   @default("")
  date  DateTime
  count Int      @default(0)

  @@unique([name, path, date])
  @@index([date])
}

/// Normalized daily metrics from growth-data connectors (GA4, Ads, Meta).
/// One shape for every provider; unique per dimension so a re-sync corrects
/// values instead of duplicating them.
model ProviderMetricDaily {
  id          String   @id @default(cuid())
  workspaceId String
  provider    String
  metric      String
  date        DateTime
  dimension   String   @default("")
  value       Float    @default(0)
  currency    String?
  meta        Json?
  updatedAt   DateTime @updatedAt

  @@unique([workspaceId, provider, metric, date, dimension])
  @@index([workspaceId, date])
}
