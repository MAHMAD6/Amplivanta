model Notification {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String?
  category    String?
  title       String
  body        String?   @db.Text
  message     String?   @db.Text
  type        String    @default("info")
