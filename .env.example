# ---------------------------------------------------------------------------
# Core (required)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/amplivanta?schema=public"
# Auth.js / NextAuth secret — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
AUTH_SECRET=
NEXTAUTH_URL="http://localhost:3000"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Seed admin credentials (prisma/seed.ts)
ADMIN_EMAIL="admin@amplivanta.com"
ADMIN_PASSWORD="Admin@123456"

# ---------------------------------------------------------------------------
# AI (optional — falls back to a deterministic stub when unset)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
AI_MODEL="claude-sonnet-5"

# ---------------------------------------------------------------------------
# Rate limiting / job queue (optional — in-memory fallback when unset)
# ---------------------------------------------------------------------------
REDIS_URL=

# ---------------------------------------------------------------------------
# Email / SMTP (optional)
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Amplivanta <hello@amplivanta.com>"

# ---------------------------------------------------------------------------
# Billing — Stripe (optional)
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe Price IDs per plan (from the Stripe dashboard). Unset = local no-charge
# fallback. Set these, then run `npm run db:seed` to attach them to the plans.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_ENTERPRISE=

# ---------------------------------------------------------------------------
# Object storage — Cloudflare R2 / S3-compatible (optional)
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# ---------------------------------------------------------------------------
# OAuth integrations (optional — stubbed until real credentials are provided)
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# External providers (External API Master Revision, Sept 2026)
# Everything below is optional: each integration stays off until its keys are
# set, and the UI says so rather than pretending it is available.
# ---------------------------------------------------------------------------
# Stripe one-time credit packs (JSON). Quantities and prices are commercial
# decisions, so none are built in. Example:
# CREDIT_PACKS=[{"code":"credits_1000","label":"1,000 credits","credits":1000,"priceId":"price_..."}]
CREDIT_PACKS=
# Stripe Connect for third-party seller payouts (Phase 2). Leave unset until
# onboarding, reconciliation and dispute handling are approved.
STRIPE_CONNECT_ENABLED=
# Marketplace buyers pay through Stripe once an operator sets the Marketplace
# setting payment.provider = {"provider":"stripe"} and the Stripe keys exist.

# Object storage — IONOS S3-compatible (preferred over R2 when set)
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
# Private bucket for Marketplace deliverables (defaults to S3_BUCKET)
S3_PRIVATE_BUCKET=
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=

# Email — Amazon SES. Sends through the SES SMTP interface with SES SMTP
# credentials; bounces and complaints arrive via SNS at /api/webhooks/ses.
EMAIL_PROVIDER=
SES_REGION=
SES_SMTP_USER=
SES_SMTP_PASS=
SES_CONFIGURATION_SET=
# SNS topic ARN(s) allowed to post SES events, comma-separated
SES_SNS_TOPIC_ARNS=

# Sign-in with Google / Microsoft (links to an existing account by verified email)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# Tenant issuer, e.g. https://login.microsoftonline.com/<tenant-id>/v2.0 (or /common/v2.0)
AUTH_MICROSOFT_ENTRA_ID_ISSUER=
# Microsoft connected-data integration (separate from sign-in)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=

# Cloudflare Turnstile (abuse protection on signup and public forms)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------------------
# AI providers
# ---------------------------------------------------------------------------
# anthropic | openai (defaults to whichever key is present)
AI_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=
AI_TIMEOUT_MS=
# fal.ai video generation. Models must be allow-listed server-side, and
# FAL_VIDEO_CREDIT_COST meters each job against workspace credits.
FAL_KEY=
FAL_MODELS=
FAL_VIDEO_CREDIT_COST=
FAL_TIMEOUT_MS=

# ---------------------------------------------------------------------------
# Growth-data connectors (per-workspace OAuth; ids live on the connection)
# ---------------------------------------------------------------------------
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=
META_CLIENT_ID=
META_CLIENT_SECRET=
META_API_VERSION=
# Cloudflare read-only status (zones); never used to change DNS or WAF rules
CLOUDFLARE_API_TOKEN=

# ---------------------------------------------------------------------------
# Later-phase connectors (Phase 1.1 / Phase 2) - unavailable until set
# ---------------------------------------------------------------------------
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_LOGIN_URL=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_SHOP_DOMAIN=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
